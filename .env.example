# =========================================================================
# ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Supabase PostgreSQL Database Direct Connection
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.sxxblqdvwebhloavmufh:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 2. Supabase Public Project URL & Anon Key
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://sxxblqdvwebhloavmufh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (Required for S3 Storage Uploads & Backend Administration)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Application Base URL (Used for QR Code links on generated Admit Cards)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTE: If DATABASE_URL is not set, the application operates smoothly in local in-memory
# mode with pre-seeded autonomous college mock data and Base64 image encoding.
